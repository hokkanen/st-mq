# Disposable offline qualification; never used by the household application.
FROM node:22.23.2-alpine AS sqlite-tools
RUN apk add --no-cache build-base curl unzip
COPY scripts/build-sqlite-rsync.js /build-sqlite-rsync.js
RUN node /build-sqlite-rsync.js --output /usr/local/bin/sqlite3_rsync

FROM node:22.23.2-alpine
RUN apk add --no-cache bash git openssl python3 py3-jinja2 py3-yaml openssh-client openssh-server mosquitto \
    && mkdir -p /run/sshd /qualification
COPY --from=sqlite-tools /usr/local/bin/sqlite3_rsync /usr/local/bin/sqlite3_rsync
WORKDIR /st-mq
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Some installer tests need an ordinary committed source tree. This Git identity
# is synthetic; the source digest in the receipts identifies the tested files.
RUN git init -q && git config user.name 'Synthetic qualification' \
    && git config user.email 'qualification@example.invalid' \
    && git config core.hooksPath .githooks && git add --all \
    && git commit -qm 'Isolated qualification source'
ENV STMQ_ADDON=0 HOME=/tmp/qualification-home STMQ_CONFIG=/tmp/qualification-home/unconfigured.json
CMD ["bash", "-c", "npm run build > /qualification/build.log 2>&1; build=$?; node scripts/test-offline.js --profile=ha-sd --report=/qualification/routine.jsonl > /qualification/routine.log 2>&1; routine=$?; node scripts/test-offline.js --profile=ha-sd --extended --report=/qualification/extended.jsonl > /qualification/extended.log 2>&1; extended=$?; printf '%s\\n' \"build=$build routine=$routine extended=$extended\"; test $build -eq 0 -a $routine -eq 0 -a $extended -eq 0"]
