{
  "name": "DHWR power to MQTT",
  "actions": [
    {
      "if": {
        "greaterThanOrEquals": {
          "left": {
            "device": {
              "devices": [
                "REPLACE_DHWR_RELAY_DEVICE_ID"
              ],
              "component": "main",
              "capability": "powerMeter",
              "attribute": "power",
              "trigger": "Always"
            }
          },
          "right": {
            "decimal": 0
          },
          "changesOnly": false
        },
        "then": [
          {
            "command": {
              "devices": [
                "REPLACE_MQTT_ENERGY_DEVICE_ID"
              ],
              "commands": [
                {
                  "component": "main",
                  "capability": "partyvoice23922.setpower",
                  "command": "setPower",
                  "arguments": [
                    {
                      "device": {
                        "devices": [
                          "REPLACE_DHWR_RELAY_DEVICE_ID"
                        ],
                        "component": "main",
                        "capability": "powerMeter",
                        "attribute": "power"
                      }
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
