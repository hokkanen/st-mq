# Reproducible builds, dependencies and local runtime state (including symlinks).
dist/
node_modules/
/var
# Defense in depth for root-adapter helper directories. Runtime validation also
# rejects placing a root-owned helper identity in a repository checkout.
**/.*-https-helper/

# Household CSV imports and database snapshots belong outside the checkout.
share/
*.csv
*.sqlite*
.env
.env.*
!.env.example

# Local credentials, decryption keys, and private configuration backups.
*.key
*.pem
*.p12
*.pfx
options.json.*

# Private configuration is external; ignore accidental local uploads and copies.
secrets.json
secrets.json.*
options.json
/data/
