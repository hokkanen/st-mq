# Ubuntu Mosquitto 2.0. Keep existing listeners and password_file settings.
# Confirm the installed plugin path for the machine architecture.
plugin /usr/lib/x86_64-linux-gnu/mosquitto_dynamic_security.so
plugin_opt_config_file /etc/mosquitto/stmq-meross/dynamic-security.json

# Local upstream for the ST-MQ VIP TLS frontend.
listener 8885 127.0.0.1
certfile /etc/mosquitto/stmq-meross/server.crt
keyfile /etc/mosquitto/stmq-meross/server.key
require_certificate false
