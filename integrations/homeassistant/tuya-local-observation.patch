+    @property
+    def local_observations(self):
+        """Confirmed wire reports, separate from pending command values."""
+        return {
+            "identity": sha256(self.unique_id.encode("utf-8")).hexdigest(),
+            **deepcopy(self._local_observations),
+        }
+
+    def _clear_local_observations(self):
+        changed = bool(getattr(self, "_local_observations", {}))
+        self._local_observations = {}
+        if changed:
+            for entity in self._children:
+                entity.schedule_update_ha_state()
+
+    def _observe_local_dps(self, dps, full_poll=False):
+        if not isinstance(dps, dict):
+            return
+        # Only these four independently reported DESD8LW fields are exported.
+        # Heartbeats, errors and pending command overlays cannot renew them.
+        if full_poll:
+            self._local_observations = {}
+        reported_at = int(time() * 1000)
+        for key in ("1", "2", "4", "6"):
+            if key in dps:
+                self._local_observations[key] = {
+                    "value": deepcopy(dps[key]), "timestamp": reported_at
+                }
+
