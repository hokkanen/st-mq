+                "connection-mode-changed", "forced-read-with-pending-query",
+                "native-transport-error", "receive-cancelled", "receive-exception",
+                "reply-context-changed", "connection-context-changed",
+                "failed-frame-integrity-flag", "cache-reset", "native-call-retry",
