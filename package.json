{
  "name": "st-mq",
  "version": "0.9.5-dev.3",
  "private": true,
  "description": "Home energy monitoring, heating control, EV charging and historical analysis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hokkanen/st-mq.git"
  },
  "homepage": "https://github.com/hokkanen/st-mq#readme",
  "bugs": {
    "url": "https://github.com/hokkanen/st-mq/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node src/main.js",
    "test": "node --test --test-concurrency=4 --test-timeout=60000 test/*.test.js",
    "test:unit": "npm test --",
    "test:extended": "node --test --test-concurrency=2 --test-timeout=180000 test/extended/*.test.js",
    "test:all": "npm test && npm run test:extended",
    "test:live": "node scripts/test-live.js",
    "deploy:ha": "node scripts/deploy-ha.js",
    "history": "node scripts/history.js",
    "check": "npm run build && npm test"
  },
  "type": "module",
  "devDependencies": {
    "vite": "^7.1.6"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "chart.js": "^4.5.0",
    "fast-xml-parser": "^5.2.5",
    "moment-timezone": "^0.6.0",
    "mqtt": "^5.14.1",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
