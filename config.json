{
  "name": "ST-MQ",
  "description": "Home energy monitoring, learned heating scheduling and read-only H66 acquisition",
  "version": "0.9.0",
  "url": "https://github.com/hokkanen/st-mq",
  "slug": "st-mq",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "startup": "services",
  "boot": "auto",
  "init": false,
  "ports": {
    "1234/tcp": 1234
  },
  "map": [
    "share:rw",
    "addon_config:rw"
  ],
  "options": {
    "geoloc": {
      "country_code": "fi",
      "latitude": "60.3972",
      "longitude": "25.6578"
    },
    "mqtt": {
      "address": "mqtt://core-mosquitto",
      "user": "",
      "pw": ""
    },
    "entsoe": {
      "token": ""
    },
    "smartthings": {
      "token": "",
      "inside_temp_dev_id": "",
      "garage_temp_dev_id": "",
      "outside_temp_dev_id": ""
    },
    "easee": {
      "user": "",
      "pw": "",
      "access_token": "",
      "refresh_token": "",
      "charger_id": "",
      "equalizer_id": ""
    },
    "controller": {
      "input": "simulated",
      "mode": "shadow",
      "web_token": "",
      "h66_device": "",
      "max_drop_c": 1,
      "h66_verification_file": "",
      "aux_integral_a2": -990,
      "aux_hysteresis_c": 30,
      "compressor_integral_a1": null,
      "compressor_hysteresis_c": null,
      "a2_basis": "absolute",
      "heat_pump_compressor_kw": 3,
      "auxiliary_rated_kw": 9,
      "circulation_kw": 0.08,
      "dhwr_kw": 0.025,
      "max_reduction_hours": 4,
      "max_away_reduction_hours": 12,
      "max_unobserved_reduction_hours": 0.5,
      "max_preheat_hours": 2,
      "max_room_boost_c": 5,
      "learning_trials": true,
      "trial_budget_cents_per_day": 100,
      "max_trial_cost_cents": 50,
      "recovery_timeout_hours": 48
    },
    "electricity": {
      "margin_ct_per_kwh_ex_vat": 0.33,
      "tax_ct_per_kwh_ex_vat": 2.325,
      "vat_percent": 25.5,
      "transfer_tariff": "day-night",
      "day_transfer_ct_per_kwh_ex_vat": 2.66,
      "night_transfer_ct_per_kwh_ex_vat": 1.56,
      "winter_day_transfer_ct_per_kwh_ex_vat": 3.32,
      "other_transfer_ct_per_kwh_ex_vat": 1.65,
      "effective_date": ""
    }
  },
  "schema": {
    "geoloc": {
      "country_code": "str",
      "latitude": "str?",
      "longitude": "str?"
    },
    "mqtt": {
      "address": "str",
      "user": "str",
      "pw": "password"
    },
    "entsoe": {
      "token": "password?",
      "domain": "str?"
    },
    "smartthings": {
      "token": "password?",
      "inside_temp_dev_id": "str?",
      "garage_temp_dev_id": "str?",
      "outside_temp_dev_id": "str?"
    },
    "easee": {
      "user": "str?",
      "pw": "password?",
      "access_token": "password?",
      "refresh_token": "password?",
      "charger_id": "str?",
      "equalizer_id": "str?"
    },
    "controller": {
      "input": "list(simulated|offline|mqtt|providers)",
      "mode": "list(monitoring|shadow|active)",
      "web_token": "password",
      "h66_device": "str?",
      "max_drop_c": "float(0,2)",
      "h66_verification_file": "str?",
      "aux_integral_a2": "int(-5000,-1)",
      "aux_hysteresis_c": "float(1,50)",
      "compressor_integral_a1": "int(-1000,-1)?",
      "compressor_hysteresis_c": "float(1,50)?",
      "a2_basis": "list(absolute|offset)",
      "heat_pump_compressor_kw": "float(0.1,20)",
      "auxiliary_rated_kw": "float(0.1,20)",
      "circulation_kw": "float(0,1)",
      "dhwr_kw": "float(0,1)",
      "max_reduction_hours": "float(0.25,12)",
      "max_away_reduction_hours": "float(0.25,24)",
      "max_unobserved_reduction_hours": "float(0.25,2)",
      "max_preheat_hours": "float(0.25,6)",
      "max_room_boost_c": "int(1,5)",
      "learning_trials": "bool",
      "trial_budget_cents_per_day": "int(0,1000)",
      "max_trial_cost_cents": "int(0,1000)",
      "recovery_timeout_hours": "int(4,168)"
    },
    "electricity": {
      "margin_ct_per_kwh_ex_vat": "float(-20,100)",
      "tax_ct_per_kwh_ex_vat": "float(0,100)",
      "vat_percent": "float(0,100)",
      "transfer_tariff": "list(day-night|seasonal)",
      "day_transfer_ct_per_kwh_ex_vat": "float(0,100)",
      "night_transfer_ct_per_kwh_ex_vat": "float(0,100)",
      "winter_day_transfer_ct_per_kwh_ex_vat": "float(0,100)",
      "other_transfer_ct_per_kwh_ex_vat": "float(0,100)",
      "effective_date": "str?"
    }
  },
  "webui": "http://[HOST]:[PORT:1234]",
  "backup": "cold",
  "timeout": 30
}
