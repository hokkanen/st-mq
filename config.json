      "max_age_seconds": "int(30,900)",
      "garage": {
        "enabled": "bool",
        "generation": "int(1,4)",
        "topic_prefix": "str?",
        "switch_id": "int(0,3)",
        "temperature_id": "int(0,255)",
        "controls_heat": "bool",
        "reduction_on": "bool"
      },
      "heat_savings": {
        "enabled": "bool",
        "generation": "int(1,4)",
        "topic_prefix": "str?",
        "switch_id": "int(0,3)",
        "controls_heat": "bool",
        "reduction_on": "bool"
      },
      "caravan": {
        "enabled": "bool",
        "generation": "int(1,4)",
        "topic_prefix": "str?",
        "switch_id": "int(0,3)",
        "nominal_voltage": "int(100,260)"
      }
    },
    "equipment": {
      "poll_seconds": "int(5,300)",
      "max_age_seconds": "int(30,3600)",
      "devices": [
        {
          "id": "str",
          "label": "str?",
          "area": "list(home|garage)",
          "kind": "list(temperature|switch|metered_switch|door|heat_pump)",
          "connection": "str",
          "enabled": "bool?",
          "signal": "str?",
          "generation": "int(1,4)?",
          "switch_id": "int(0,255)?",
          "temperature_id": "int(0,255)?",
