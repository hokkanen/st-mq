{
    "name": "ST-MQ",
    "description": "Local home-energy monitoring, offline learning and simulated heating control",
    "version": "0.8.0",
    "url": "https://github.com/hokkanen/st-mq",
    "slug": "st-mq",
    "arch": [
        "aarch64",
        "amd64"
    ],
    "startup": "services",
    "boot": "auto",
    "init": false,
    "ports": {
        "1234/tcp": 1234
    },
    "map": [
        "share:rw"
    ],
    "options": {
        "geoloc": {
            "country_code": "fi",
            "latitude": "60.3972",
            "longitude": "25.6578"
        },
        "temp_to_hours": [
            {
                "temp": 30,
                "hours": 2
            },
            {
                "temp": 20,
                "hours": 12
            },
            {
                "temp": 10,
                "hours": 14
            },
            {
                "temp": 0,
                "hours": 16
            },
            {
                "temp": -10,
                "hours": 18
            },
            {
                "temp": -20,
                "hours": 20
            },
            {
                "temp": -30,
                "hours": 24
            }
        ],
        "mqtt": {
            "address": "mqtt://core-mosquitto",
            "user": "",
            "pw": ""
        },
        "entsoe": {
            "token": ""
        },
        "smartthings": {
            "token": "",
            "inside_temp_dev_id": "",
            "garage_temp_dev_id": "",
            "outside_temp_dev_id": ""
        },
        "openweathermap": {
            "token": ""
        },
        "easee": {
            "user": "",
            "pw": "",
            "access_token": "",
            "refresh_token": "",
            "charger_id": "EHXXXXXX",
            "equalizer_id": "QPXXXXXX"
        },
        "controller": {
            "input": "simulated",
            "mode": "shadow",
            "web_token": "",
            "h66_device": ""
        }
    },
    "schema": {
        "geoloc": {
            "country_code": "str",
            "latitude": "str?",
            "longitude": "str?"
        },
        "temp_to_hours": [
            {
                "temp": "int",
                "hours": "int"
            }
        ],
        "mqtt": {
            "address": "str",
            "user": "str",
            "pw": "password"
        },
        "entsoe": {
            "token": "password?"
        },
        "smartthings": {
            "token": "password?",
            "inside_temp_dev_id": "str?",
            "garage_temp_dev_id": "str?",
            "outside_temp_dev_id": "str?"
        },
        "openweathermap": {
            "token": "password?"
        },
        "easee": {
            "user": "str?",
            "pw": "password?",
            "access_token": "password?",
            "refresh_token": "password?",
            "charger_id": "str",
            "equalizer_id": "str"
        },
        "controller": {
            "input": "list(simulated|offline|mqtt)",
            "mode": "list(monitoring|shadow|active)",
            "web_token": "password",
            "h66_device": "str?"
        }
    },
    "webui": "http://[HOST]:[PORT:1234]"
}
