{
  "name": "ST-MQ",
  "description": "Home energy monitoring, learned heating scheduling and read-only H66 acquisition",
  "version": "0.9.0",
  "url": "https://github.com/hokkanen/st-mq",
  "slug": "st-mq",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "startup": "services",
  "boot": "auto",
  "init": false,
  "ingress": true,
  "ingress_port": 8099,
  "panel_icon": "mdi:home-lightning-bolt",
  "panel_title": "ST-MQ",
  "ports": {
    "1234/tcp": 1234
  },
  "ports_description": {
    "1234/tcp": "Direct web access; enabled only when a web token is configured"
  },
  "webui": "http://[HOST]:[PORT:1234]",
  "map": [
    "share:rw",
    "addon_config:rw"
  ],
  "backup": "cold",
  "timeout": 30,
  "options": {
    "geoloc": {
      "country_code": "fi",
      "latitude": "",
      "longitude": ""
    },
    "mqtt": {
      "address": "mqtt://core-mosquitto",
      "user": "",
      "pw": "",
      "indoor_temperature_topic": "",
      "garage_temperature_topic": ""
    },
    "entsoe": {
      "token": ""
    },
    "smartthings": {
      "token": "",
      "inside_temp_dev_id": "",
      "garage_temp_dev_id": ""
    },
    "easee": {
      "user": "",
      "pw": "",
      "charger_id": "",
      "equalizer_id": "",
      "charger_voltage_ids": []
    },
    "teslamate": {
      "enabled": true,
      "car_id": "1",
      "home_geofence": "Home",
      "namespace": "",
      "charger_assignment": "auto",
      "charger_identification": true,
      "max_age_seconds": 180
    },
    "electricity": {
      "margin_ct_per_kwh_ex_vat": 0.33,
      "tax_ct_per_kwh_ex_vat": 2.325,
      "vat_percent": 25.5,
      "transfer_tariff": "day-night",
      "day_transfer_ct_per_kwh_ex_vat": 2.66,
      "night_transfer_ct_per_kwh_ex_vat": 1.56,
      "winter_day_transfer_ct_per_kwh_ex_vat": 3.32,
      "other_transfer_ct_per_kwh_ex_vat": 1.65,
      "effective_date": ""
    },
    "controller": {
      "input": "simulated",
      "mode": "shadow",
      "web_token": "",
      "h66_device": "",
      "max_drop_c": 1,
      "h66_verification_file": "",
      "aux_integral_a2": -990,
      "aux_hysteresis_c": 30,
      "compressor_integral_a1": -100,
      "compressor_hysteresis_c": 10,
      "a2_basis": "absolute",
      "heat_pump_compressor_kw": 3,
      "auxiliary_rated_kw": 9,
      "circulation_kw": 0.08,
      "dhwr_kw": 0.025,
      "max_reduction_hours": 4,
      "max_away_reduction_hours": 12,
      "max_unobserved_reduction_hours": 0.5,
      "max_preheat_hours": 2,
      "max_room_boost_c": 5,
      "learning_trials": true,
      "trial_budget_cents_per_day": 100,
      "max_trial_cost_cents": 50,
      "recovery_timeout_hours": 48,
      "recovery_compressor_only": true,
      "recovery_compressor_only_hours": 4,
      "recovery_comfort_margin_c": 0.5,
      "role": "primary"
    },
    "acquisition": {
      "easee_poll_seconds": 15,
      "weather_poll_minutes": 30,
      "outdoor_poll_minutes": 5,
      "market_poll_minutes": 60,
      "market_retry_minutes": 15,
      "electricity_source_max_age_seconds": 300,
      "electricity_max_gap_seconds": 60,
      "electricity_telemetry_max_age_seconds": 1020
    },
    "recording": {
      "max_interval_minutes": 5,
      "annual_budget_gb": 10
    },
    "replication": {
      "enabled": false,
      "directory": "",
      "ssh_host": "",
      "remote_directory": "",
      "receiver_path": "",
      "node_path": "node",
      "rsync_path": "sqlite3_rsync",
      "remote_rsync_path": "sqlite3_rsync",
      "interval_seconds": 60,
      "timeout_seconds": 3600,
      "stale_seconds": 180,
      "ssh_config": ""
    },
    "pairing": {
      "enabled": false,
      "pair_id": "",
      "token": "",
      "peer_url": "",
      "listen_host": "0.0.0.0",
      "port": 1244,
      "directory": "",
      "interval_seconds": 60,
      "timeout_seconds": 3600,
      "vip_interface": "",
      "vip_address": "",
      "vip_prefix": 24,
      "vip_helper": "/usr/local/bin/st-mq-vip",
      "vip_socket": ""
    }
  },
  "schema": {
    "geoloc": {
      "country_code": "str",
      "latitude": "str?",
      "longitude": "str?"
    },
    "mqtt": {
      "address": "str",
      "user": "str",
      "pw": "password",
      "indoor_temperature_topic": "str?",
      "garage_temperature_topic": "str?"
    },
    "entsoe": {
      "token": "password?",
      "domain": "str?"
    },
    "smartthings": {
      "token": "password?",
      "inside_temp_dev_id": "str?",
      "garage_temp_dev_id": "str?"
    },
    "easee": {
      "user": "str?",
      "pw": "password?",
      "charger_id": "str?",
      "equalizer_id": "str?",
      "charger_voltage_ids": [
        "int(190,199)"
      ]
    },
    "teslamate": {
      "enabled": "bool",
      "car_id": "str",
      "home_geofence": "str",
      "namespace": "str?",
      "charger_assignment": "list(auto|bmw|easee)",
      "charger_identification": "bool",
      "max_age_seconds": "int(30,600)"
    },
    "electricity": {
      "margin_ct_per_kwh_ex_vat": "float(-20,100)",
      "tax_ct_per_kwh_ex_vat": "float(0,100)",
      "vat_percent": "float(0,100)",
      "transfer_tariff": "list(day-night|seasonal)",
      "day_transfer_ct_per_kwh_ex_vat": "float(0,100)",
      "night_transfer_ct_per_kwh_ex_vat": "float(0,100)",
      "winter_day_transfer_ct_per_kwh_ex_vat": "float(0,100)",
      "other_transfer_ct_per_kwh_ex_vat": "float(0,100)",
      "effective_date": "str?"
    },
    "controller": {
      "input": "list(simulated|offline|mqtt|providers)",
      "mode": "list(monitoring|shadow|active)",
      "web_token": "password",
      "h66_device": "str?",
      "max_drop_c": "float(0,2)",
      "h66_verification_file": "str?",
      "aux_integral_a2": "int(-5000,-1)",
      "aux_hysteresis_c": "float(1,50)",
      "compressor_integral_a1": "int(-1000,-1)?",
      "compressor_hysteresis_c": "float(1,50)?",
      "a2_basis": "list(absolute|offset)",
      "heat_pump_compressor_kw": "float(0.1,20)",
      "auxiliary_rated_kw": "float(0.1,20)",
      "circulation_kw": "float(0,1)",
      "dhwr_kw": "float(0,1)",
      "max_reduction_hours": "float(0.25,12)",
      "max_away_reduction_hours": "float(0.25,24)",
      "max_unobserved_reduction_hours": "float(0.25,2)",
      "max_preheat_hours": "float(0.25,6)",
      "max_room_boost_c": "int(1,5)",
      "learning_trials": "bool",
      "trial_budget_cents_per_day": "int(0,1000)",
      "max_trial_cost_cents": "int(0,1000)",
      "recovery_timeout_hours": "int(4,168)",
      "recovery_compressor_only": "bool",
      "recovery_compressor_only_hours": "float(0.25,12)",
      "recovery_comfort_margin_c": "float(0,1)",
      "role": "list(primary|replica)"
    },
    "acquisition": {
      "easee_poll_seconds": "float(10,3600)",
      "weather_poll_minutes": "float(5,360)",
      "outdoor_poll_minutes": "float(1,60)",
      "market_poll_minutes": "float(15,1440)",
      "market_retry_minutes": "float(5,60)",
      "electricity_source_max_age_seconds": "float(15,3600)",
      "electricity_max_gap_seconds": "float(15,300)",
      "electricity_telemetry_max_age_seconds": "float(15,3600)"
    },
    "recording": {
      "max_interval_minutes": "float(0.25,60)",
      "annual_budget_gb": "float(0.01,10000)"
    },
    "replication": {
      "enabled": "bool",
      "directory": "str?",
      "ssh_host": "str?",
      "remote_directory": "str?",
      "receiver_path": "str?",
      "node_path": "str",
      "rsync_path": "str",
      "remote_rsync_path": "str",
      "interval_seconds": "int(10,86400)",
      "timeout_seconds": "int(30,86400)",
      "stale_seconds": "int(30,604800)",
      "ssh_config": "str?"
    },
    "pairing": {
      "enabled": "bool",
      "pair_id": "str?",
      "token": "password?",
      "peer_url": "str?",
      "listen_host": "str",
      "port": "int(1,65535)",
      "directory": "str?",
      "interval_seconds": "int(10,86400)",
      "timeout_seconds": "int(30,86400)",
      "vip_interface": "str?",
      "vip_address": "str?",
      "vip_prefix": "int(1,30)",
      "vip_helper": "str",
      "vip_socket": "str?"
    }
  },
  "host_network": true,
  "privileged": [
    "NET_ADMIN",
    "NET_RAW"
  ]
}
