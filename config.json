{
  "name": "ST-MQ",
  "description": "Home energy monitoring, learned heating scheduling and read-only H66 acquisition",
  "version": "0.9.0",
  "url": "https://github.com/hokkanen/st-mq",
  "slug": "st-mq",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "startup": "services",
  "boot": "auto",
  "init": false,
  "ingress": true,
  "ingress_port": 8099,
  "panel_icon": "mdi:home-lightning-bolt",
  "panel_title": "ST-MQ",
  "ports": {

    "1234/tcp": 1234
  },
  "ports_description": {

    "1234/tcp": "Direct web access; enabled only when a web token is configured"
  },
  "webui": "http://[HOST]:[PORT:1234]",
  "map": [
    "share:rw",
    "addon_config:rw"
  ],
  "backup": "cold",
  "timeout": 30,
  "host_network": true,
  "privileged": [
    "NET_ADMIN",
    "NET_RAW"
  ],

  "options": {

    "controller": {
      "input": "simulated",
      "mode": "shadow",
      "role": "primary",
      "web_token": "",

      "max_drop_c": 1.5,
      "max_rise_c": 1.5,
      "savings_strategy": "balanced",
      "preheat_room_boost_c": 5,
      "indoor_sensor_weights": {},

      "h66_device": "",
      "h66_verification_file": "",
      "heat_pump_model_confirmed": false,
      "aux_integral_a2": -990,
      "aux_hysteresis_c": 30,
      "compressor_integral_a1": -100,
      "compressor_hysteresis_c": 10,
      "a2_basis": "absolute",

      "heat_pump_compressor_kw": 3,
      "auxiliary_rated_kw": 9,
      "circulation_kw": 0.08,
      "dhwr_kw": 0.025,
      "dhwr_duration_minutes": 10,

      "max_reduction_hours": 4,
      "max_away_reduction_hours": 12,
      "max_unobserved_reduction_hours": 0.5,
      "max_preheat_hours": 2,

      "learning_trials": true,
      "trial_budget_cents_per_day": 100,
      "max_trial_cost_cents": 50,
      "recovery_timeout_hours": 48,
      "recovery_compressor_only": true,
      "recovery_hold_minutes": 60,
      "recovery_comfort_margin_c": 0.5,

      "floor_thermal_priors": {
        "capacity_kwh_per_c": 3.2,
        "native_capacity_kwh_per_c": 8.832,
        "exchange_kw_per_c": 0.266667,
        "ground_loss_kw_per_c": 0.013596,
        "ground_c": 10,
        "open_allocation_fraction": 0.4,
        "closed_allocation_fraction": 0.05
      },

      "floor_preheat": {
        "enabled": false,
        "commissioned": false,
        "storage": {
          "topic_prefix": ""
        },
        "living": {
          "topic_prefix": ""
        },
        "renew_seconds": 300,
        "lease_seconds": 900
      }
    },

    "garage": {
      "enabled": false,
      "savingsStrategy": "balanced",
      "baselineC": 10,

      "minSavingsEur": 0.5,
      "maxPausesPerDay": 1,
      "minOnMs": 10800000,
      "minOffMs": 3600000,
      "stepMinutes": 15,

      "maxSensorAgeMs": 120000,

      "protection": {
        "approved": false,
        "version": "garage-thermal-reserve-v1",
        "marginC": 1,
        "pipeOutsideDiameterMm": 21,
        "pipeWallMm": 1,
        "heatTransferWPerM2K": 20
      },

      "adapter": {
        "driver": "shelly-cn105",
        "stateTopic": "heatpump/garage/state",
        "telemetryTopic": "heatpump/garage/telemetry",
        "commandTopic": "heatpump/garage/command",
        "maxAgeMs": 120000,
        "electricalSource": "none"
      }
    },

    "charging": {
      "chargers": {
        "charger1": {},
        "charger2": {
          "enabled": false,
          "profile": "top-ac-portable",
          "deviceId": "",
          "model": "",
          "firmware": "",
          "topicPrefix": "",
          "associationVersion": 1,
          "verified": false,
          "serviceId": 0,
          "minimumCurrentA": 6,
          "maximumCurrentA": 16,
          "currentStepA": 1,
          "limiterEnabled": false,
          "fallbackCurrentA": 12,
          "mainFuseA": [
            25,
            25,
            25
          ],
          "marginA": [
            1,
            1,
            1
          ],
          "phaseMap": [
            0,
            1,
            2
          ],
          "additiveCurrentVerified": false,
          "maxAgeMs": 15000,
          "maxSkewMs": 5000,
          "dwellMs": 30000,
          "rampA": 2,
          "connectedStates": [],
          "disconnectedStates": [],
          "chargingStates": []
        }
      },
      "vehicles": {
        "bmw": {
          "label": "BMW",
          "provider": "bmw-cardata",
          "mqttTopic": "stmq/vehicles/bmw"
        }
      }
    },

    "electricity": {
      "margin_ct_per_kwh_ex_vat": 0.33,
      "tax_ct_per_kwh_ex_vat": 2.325,
      "vat_percent": 25.5,
      "transfer_tariff": "day-night",
      "day_transfer_ct_per_kwh_ex_vat": 2.66,
      "night_transfer_ct_per_kwh_ex_vat": 1.56,
      "winter_day_transfer_ct_per_kwh_ex_vat": 3.32,
      "other_transfer_ct_per_kwh_ex_vat": 1.65,
      "effective_date": ""
    },

    "geoloc": {
      "country_code": "fi",
      "latitude": "",
      "longitude": ""
    },

    "mqtt": {
      "address": "mqtt://core-mosquitto",
      "user": "",
      "pw": "",
      "dhwr_topic": "stmq/home/dhwr/command/switch",
      "temperature_report_interval_minutes": 70,
      "temperature_report_grace_seconds": 300
    },

    "entsoe": {
      "token": ""
    },

    "easee": {
      "user": "",
      "pw": "",
      "charger_id": "",
      "equalizer_id": "",
      "charger_voltage_ids": [],
      "local_ocpp": {
        "enabled": true,
        "host": "0.0.0.0",
        "port": 9001,
        "server_url": "",
        "ca_certificate": "",
        "ca_certificate_domain": "",
        "password": "",
        "charge_point_id": "",
        "authorization_tags": [],
        "authorization_mode": "rfid"
      }
    },

    "teslamate": {
      "enabled": true,
      "carId": "1",
      "homeGeofence": "Home",
      "namespace": "",
      "maxAgeMs": 180000
    },

    "equipment": {
      "poll_seconds": 30,
      "max_age_seconds": 120,
      "devices": [
        {
          "id": "upstairs",
          "label": "Upstairs",
          "area": "home",
          "kind": "temperature",
          "enabled": true,
          "connection": "mqtt:stmq/home/smoke1/status/temperature",
          "signal": "indoor_temperature",
          "max_age_seconds": 4500,
          "mqtt": {},
          "readings": []
        },
        {
          "id": "downstairs",
          "label": "Downstairs",
          "area": "home",
          "kind": "temperature",
          "enabled": true,
          "connection": "mqtt:stmq/home/smoke3/status/temperature",
          "signal": "downstairs_temperature",
          "max_age_seconds": 4500,
          "mqtt": {},
          "readings": []
        },
        {
          "id": "bedroom",
          "label": "Bedroom",
          "area": "home",
          "kind": "temperature",
          "enabled": true,
          "connection": "mqtt:stmq/home/smoke2/status/temperature",
          "signal": "bedroom_temperature",
          "max_age_seconds": 4500,
          "mqtt": {},
          "readings": []
        },
        {
          "id": "heat_savings",
          "label": "Tariff control",
          "area": "home",
          "kind": "switch",
          "enabled": true,
          "connection": "shelly:stmq/home/tariff",
          "tariff_control": true,
          "reduction_on": true,
          "mqtt": {},
          "readings": []
        },
        {
          "id": "dhwr",
          "label": "Hot-water circulation",
          "area": "home",
          "kind": "power",
          "enabled": true,
          "connection": "mqtt:stmq/home/dhwr/status/power",
          "max_age_seconds": 0,
          "record": false,
          "mqtt": {},
          "readings": []
        },
        {
          "id": "garage",
          "label": "Garage temperatures",
          "area": "garage",
          "kind": "temperature",
          "enabled": true,
          "connection": "shelly:stmq/garage/temperatures",
          "temperature_id": 100,
          "signal": "garage_temperature",
          "max_age_seconds": 120,
          "mqtt": {},
          "readings": [
            {
              "key": "temperature_2",
              "label": "Garage front",
              "signal": "garage_temperature_2",
              "unit": "degC",
              "required": false,
              "component": "temperature:101"
            }
          ]
        },
        {
          "id": "blu_ht",
          "label": "Caravan air",
          "manufacturer": "Shelly",
          "area": "garage",
          "kind": "temperature",
          "connection": "mqtt:stmq/garage/caravan_air/state",
          "signal": "caravan_temperature",
          "max_age_seconds": 180,
          "mqtt": {
            "state_path": "temperature",
            "timestamp_path": "timestamp",
            "request_topic": "stmq/garage/caravan_air/get",
            "request_payload": "status"
          },
          "readings": [
            {
              "key": "humidity",
              "label": "Relative humidity",
              "signal": "caravan_humidity",
              "unit": "%",
              "required": true,
              "path": "humidity"
            },
            {
              "key": "battery",
              "label": "Battery",
              "unit": "%",
              "record": false,
              "path": "battery"
            },
            {
              "key": "rssi",
              "label": "Bluetooth signal",
              "unit": "dBm",
              "record": false,
              "path": "rssi"
            }
          ]
        },
        {
          "id": "caravan",
          "label": "Caravan energy",
          "area": "garage",
          "kind": "metered_switch",
          "enabled": true,
          "connection": "shelly:stmq/garage/caravan",
          "switch_control": true,
          "mqtt": {},
          "readings": []
        },
        {
          "id": "garage_door1",
          "label": "Door 1",
          "area": "garage",
          "kind": "door",
          "enabled": true,
          "connection": "mqtt:stmq/garage/door1/status/contact",
          "cover_control": true,
          "mqtt": {
            "command_topic": "stmq/garage/door1/command/cover",
            "open_payload": "open",
            "close_payload": "closed",
            "state_path": "value",
            "cover_state_path": "cover_state",
            "timestamp_path": "timestamp",
            "request_topic": "stmq/garage/door1/command",
            "request_payload": "status_update",
            "availability_topic": "stmq/garage/door1/availability",
            "bridge_availability_topic": "homeassistant/status"
          },
          "readings": []
        },
        {
          "id": "garage_door2",
          "label": "Door 2",
          "area": "garage",
          "kind": "door",
          "enabled": true,
          "connection": "mqtt:stmq/garage/door2/status/contact",
          "cover_control": true,
          "mqtt": {
            "command_topic": "stmq/garage/door2/command/cover",
            "open_payload": "open",
            "close_payload": "closed",
            "state_path": "value",
            "cover_state_path": "cover_state",
            "timestamp_path": "timestamp",
            "request_topic": "stmq/garage/door2/command",
            "request_payload": "status_update",
            "availability_topic": "stmq/garage/door2/availability",
            "bridge_availability_topic": "homeassistant/status"
          },
          "readings": []
        },
        {
          "id": "caravan_dehumidifier",
          "label": "Caravan dehumidifier",
          "area": "garage",
          "kind": "dehumidifier",
          "enabled": true,
          "connection": "mqtt:stmq/garage/caravan_dehumidifier/state",
          "signal": "caravan_dehumidifier_running_state",
          "dehumidifier_control": true,
          "temperature_control": {
            "sensor_device_id": "blu_ht"
          },
          "max_age_seconds": 180,
          "mqtt": {
            "command_topic": "stmq/garage/caravan_dehumidifier/set",
            "timestamp_path": "timestamp",
            "request_topic": "stmq/garage/caravan_dehumidifier/get",
            "request_payload": "{}",
            "availability_topic": "stmq/garage/caravan_dehumidifier/availability"
          },
          "readings": []
        }
      ]
    },

    "acquisition": {
      "easee_poll_seconds": 15,
      "weather_poll_minutes": 30,
      "outdoor_poll_minutes": 5,
      "market_poll_minutes": 60,
      "market_retry_minutes": 15,
      "electricity_source_max_age_seconds": 300,
      "electricity_max_gap_seconds": 60,
      "electricity_telemetry_max_age_seconds": 1020
    },

    "recording": {
      "max_interval_minutes": 5,
      "annual_budget_gb": 10
    },

    "pairing": {
      "enabled": false,
      "pair_id": "",
      "token": "",
      "peer_url": "",
      "listen_host": "0.0.0.0",
      "port": 1244,
      "directory": "",
      "interval_seconds": 60,
      "timeout_seconds": 3600,
      "vip_interface": "",
      "vip_address": "",
      "vip_prefix": 24,
      "vip_helper": "/usr/local/bin/st-mq-vip",
      "vip_socket": ""
    },

    "replication": {
      "enabled": false,
      "directory": "",
      "ssh_host": "",
      "remote_directory": "",
      "receiver_path": "",
      "node_path": "node",
      "rsync_path": "sqlite3_rsync",
      "remote_rsync_path": "sqlite3_rsync",
      "interval_seconds": 60,
      "timeout_seconds": 3600,
      "stale_seconds": 180,
      "ssh_config": ""
    }
  },

