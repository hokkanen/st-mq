        "indoor_temperature": "float(0,)?",
        "downstairs_temperature": "float(0,)?",
        "bedroom_temperature": "float(0,)?"
      },
      "h66_verification_file": "str?",
      "aux_integral_a2": "int(-5000,-1)",
      "aux_hysteresis_c": "float(1,50)",
      "compressor_integral_a1": "int(-1000,-1)?",
      "compressor_hysteresis_c": "float(1,50)?",
      "a2_basis": "list(absolute|offset)",
      "heat_pump_compressor_kw": "float(0.1,20)",
      "auxiliary_rated_kw": "float(0.1,20)",
      "circulation_kw": "float(0,1)",
      "dhwr_kw": "float(0,1)",
      "dhwr_duration_minutes": "float(1,60)",
      "max_reduction_hours": "float(0.25,12)",
      "max_away_reduction_hours": "float(0.25,24)",
      "max_unobserved_reduction_hours": "float(0.25,2)",
      "max_preheat_hours": "float(0.25,6)",
      "max_room_boost_c": "int(1,5)",
      "learning_trials": "bool",
      "trial_budget_cents_per_day": "int(0,1000)",
      "max_trial_cost_cents": "int(0,1000)",
      "recovery_timeout_hours": "int(4,168)",
      "recovery_compressor_only": "bool",
      "recovery_compressor_only_hours": "float(0.25,12)",
      "recovery_comfort_margin_c": "float(0,1)",
      "role": "list(primary|replica)"
    },
    "acquisition": {
      "easee_poll_seconds": "float(10,3600)",
      "weather_poll_minutes": "float(5,360)",
