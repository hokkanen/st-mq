{
  "name": "ST-MQ",
  "description": "Home energy monitoring, learned heating scheduling and read-only H66 acquisition",
  "version": "0.9.0",
  "url": "https://github.com/hokkanen/st-mq",
  "slug": "st-mq",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "startup": "services",
  "boot": "auto",
  "init": false,
  "ingress": true,
  "ingress_port": 8099,
  "panel_icon": "mdi:home-lightning-bolt",
  "panel_title": "ST-MQ",
  "ports": {
    "1234/tcp": 1234
  },
  "ports_description": {
    "1234/tcp": "Direct web access; enabled only when a web token is configured"
  },
  "webui": "http://[HOST]:[PORT:1234]",
  "map": [
    "share:rw",
    "addon_config:rw"
  ],
  "backup": "cold",
  "timeout": 30,
  "options": {
    "geoloc": {
      "country_code": "fi",
      "latitude": "",
      "longitude": ""
    },
    "mqtt": {
      "address": "mqtt://core-mosquitto",
      "user": "",
      "pw": "",
      "dhwr_topic": "from_stmq/dhwr/set",
      "indoor_temperature_topic": "",
      "downstairs_temperature_topic": "",
      "bedroom_temperature_topic": "",
      "temperature_report_interval_minutes": 15,
      "temperature_report_grace_seconds": 120,
      "garage_temperature_topic": ""
    },
    "entsoe": {
      "token": ""
    },
    "easee": {
      "user": "",
      "pw": "",
      "charger_id": "",
      "equalizer_id": "",
      "charger_voltage_ids": []
    },
    "teslamate": {
      "enabled": true,
      "car_id": "1",
      "home_geofence": "Home",
      "namespace": "",
      "charger_assignment": "auto",
      "charger_identification": true,
      "max_age_seconds": 180
    },
    "electricity": {
      "margin_ct_per_kwh_ex_vat": 0.33,
      "tax_ct_per_kwh_ex_vat": 2.325,
      "vat_percent": 25.5,
      "transfer_tariff": "day-night",
      "day_transfer_ct_per_kwh_ex_vat": 2.66,
      "night_transfer_ct_per_kwh_ex_vat": 1.56,
      "winter_day_transfer_ct_per_kwh_ex_vat": 3.32,
      "other_transfer_ct_per_kwh_ex_vat": 1.65,
      "effective_date": ""
    },
    "controller": {
      "input": "simulated",
      "mode": "shadow",
      "web_token": "",
      "h66_device": "",
      "max_drop_c": 1,
      "indoor_sensor_weights": {},
      "h66_verification_file": "",
      "aux_integral_a2": -990,
      "aux_hysteresis_c": 30,
      "compressor_integral_a1": -100,
      "compressor_hysteresis_c": 10,
      "a2_basis": "absolute",
      "heat_pump_compressor_kw": 3,
      "auxiliary_rated_kw": 9,
      "circulation_kw": 0.08,
      "dhwr_kw": 0.025,
      "dhwr_duration_minutes": 10,
      "max_reduction_hours": 4,
      "max_away_reduction_hours": 12,
      "max_unobserved_reduction_hours": 0.5,
      "max_preheat_hours": 2,
      "max_room_boost_c": 5,
      "learning_trials": true,
      "trial_budget_cents_per_day": 100,
      "max_trial_cost_cents": 50,
      "recovery_timeout_hours": 48,
      "recovery_compressor_only": true,
      "recovery_compressor_only_hours": 4,
      "recovery_comfort_margin_c": 0.5,
      "role": "primary"
    },
    "acquisition": {
      "easee_poll_seconds": 15,
      "weather_poll_minutes": 30,
      "outdoor_poll_minutes": 5,
      "market_poll_minutes": 60,
      "market_retry_minutes": 15,
      "electricity_source_max_age_seconds": 300,
      "electricity_max_gap_seconds": 60,
      "electricity_telemetry_max_age_seconds": 1020
    },
    "recording": {
      "max_interval_minutes": 5,
      "annual_budget_gb": 10
    },
    "replication": {
      "enabled": false,
      "directory": "",
      "ssh_host": "",
      "remote_directory": "",
      "receiver_path": "",
      "node_path": "node",
      "rsync_path": "sqlite3_rsync",
      "remote_rsync_path": "sqlite3_rsync",
      "interval_seconds": 60,
      "timeout_seconds": 3600,
      "stale_seconds": 180,
      "ssh_config": ""
    },
    "pairing": {
      "enabled": false,
      "pair_id": "",
      "token": "",
      "peer_url": "",
      "listen_host": "0.0.0.0",
      "port": 1244,
      "directory": "",
      "interval_seconds": 60,
      "timeout_seconds": 3600,
      "vip_interface": "",
      "vip_address": "",
      "vip_prefix": 24,
      "vip_helper": "/usr/local/bin/st-mq-vip",
      "vip_socket": ""
    },
    "equipment": {
      "poll_seconds": 30,
      "max_age_seconds": 120,
      "devices": [
        {
          "id": "upstairs",
          "label": "Upstairs",
          "area": "home",
          "kind": "temperature",
          "connection": "mqtt:stmq/smoke/1/temperature",
          "signal": "indoor_temperature",
          "max_age_seconds": 1020,
          "enabled": true,
          "mqtt": {},
          "readings": []
        },
        {
          "id": "downstairs",
          "label": "Downstairs",
          "area": "home",
          "kind": "temperature",
          "connection": "mqtt:stmq/smoke/3/temperature",
          "signal": "downstairs_temperature",
          "max_age_seconds": 1020,
          "enabled": true,
          "mqtt": {},
          "readings": []
        },
        {
          "id": "bedroom",
          "label": "Bedroom",
          "area": "home",
          "kind": "temperature",
          "connection": "mqtt:stmq/smoke/2/temperature",
          "signal": "bedroom_temperature",
          "max_age_seconds": 1020,
          "enabled": true,
          "mqtt": {},
          "readings": []
        },
        {
          "id": "heat_savings",
          "label": "Tariff control",
          "area": "home",
          "kind": "switch",
          "connection": "shelly:stmq/home/tariff",
          "tariff_control": true,
          "reduction_on": true,
          "enabled": true,
          "mqtt": {},
          "readings": []
        },
        {
          "id": "garage",
          "label": "Garage temperatures",
          "area": "garage",
          "kind": "temperature",
          "connection": "shelly:stmq/garage/temperatures",
          "signal": "garage_temperature",
          "temperature_id": 100,
          "enabled": true,
          "readings": [
            {
              "key": "temperature_2",
              "label": "Garage temperature 2",
              "signal": "garage_temperature_2",
              "unit": "degC",
              "component": "temperature:101",
              "required": false
            }
          ],
          "mqtt": {}
        },
        {
          "id": "garage_mqtt",
          "label": "Garage temperature \u00b7 MQTT",
          "area": "garage",
          "kind": "temperature",
          "connection": "mqtt:from_hass/garage/temp",
          "signal": "garage_temperature_ha",
          "max_age_seconds": 1020,
          "enabled": true,
          "mqtt": {},
          "readings": []
        },
        {
          "id": "caravan",
          "label": "Caravan",
          "area": "garage",
          "kind": "metered_switch",
          "connection": "shelly:stmq/garage/caravan",
          "switch_control": true,
          "enabled": true,
          "mqtt": {},
          "readings": []
        },
        {
          "id": "garage_door1",
          "label": "Door 1",
          "area": "garage",
          "kind": "door",
          "connection": "mqtt:from_hass/garage_door1/sensor",
          "enabled": true,
          "mqtt": {},
          "readings": []
        },
        {
          "id": "garage_door2",
          "label": "Door 2",
          "area": "garage",
          "kind": "door",
          "connection": "mqtt:from_hass/garage_door2/sensor",
          "enabled": true,
          "mqtt": {},
          "readings": []
        },
        {
          "id": "garage_heat_pump",
          "label": "Garage heat pump",
          "area": "garage",
          "kind": "heat_pump",
          "connection": "shelly:stmq/garage/heat-pump",
          "switch_control": false,
          "enabled": false,
          "mqtt": {},
          "readings": []
        }
      ]
    },
    "shelly": {
      "poll_seconds": 30,
      "max_age_seconds": 120,
      "garage": {
        "enabled": false,
        "generation": 2,
        "topic_prefix": "",
        "switch_id": 0,
        "temperature_id": 100,
        "controls_heat": false,
        "reduction_on": true
      },
      "heat_savings": {
        "enabled": false,
        "generation": 3,
        "topic_prefix": "",
        "switch_id": 0,
        "controls_heat": true,
        "reduction_on": true
      },
      "caravan": {
        "enabled": false,
        "generation": 2,
        "topic_prefix": "",
        "switch_id": 0,
        "nominal_voltage": 230
      }
    }
  },
  "schema": {
    "geoloc": {
      "country_code": "str",
      "latitude": "str?",
      "longitude": "str?"
    },
    "mqtt": {
      "address": "str",
      "user": "str",
      "pw": "password",
      "dhwr_topic": "str",
      "indoor_temperature_topic": "str?",
      "downstairs_temperature_topic": "str?",
      "bedroom_temperature_topic": "str?",
      "temperature_report_interval_minutes": "float(0,1440)",
      "temperature_report_grace_seconds": "float(0,900)",
      "garage_temperature_topic": "str?"
    },
    "entsoe": {
      "token": "password?",
      "domain": "str?"
    },
    "easee": {
      "user": "str?",
      "pw": "password?",
      "charger_id": "str?",
      "equalizer_id": "str?",
      "charger_voltage_ids": [
        "int(190,199)"
      ]
    },
    "teslamate": {
      "enabled": "bool",
      "car_id": "str",
      "home_geofence": "str",
      "namespace": "str?",
      "charger_assignment": "list(auto|bmw|easee)",
      "charger_identification": "bool",
      "max_age_seconds": "int(30,600)"
    },
    "electricity": {
      "margin_ct_per_kwh_ex_vat": "float(-20,100)",
      "tax_ct_per_kwh_ex_vat": "float(0,100)",
      "vat_percent": "float(0,100)",
      "transfer_tariff": "list(day-night|seasonal)",
      "day_transfer_ct_per_kwh_ex_vat": "float(0,100)",
      "night_transfer_ct_per_kwh_ex_vat": "float(0,100)",
      "winter_day_transfer_ct_per_kwh_ex_vat": "float(0,100)",
      "other_transfer_ct_per_kwh_ex_vat": "float(0,100)",
      "effective_date": "str?"
    },
    "controller": {
      "input": "list(simulated|offline|mqtt|providers)",
      "mode": "list(monitoring|shadow|active)",
      "web_token": "password",
      "h66_device": "str?",
      "max_drop_c": "float(0,2)",
