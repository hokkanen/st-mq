      "market_poll_minutes": "float(15,1440)",
      "market_retry_minutes": "float(5,60)",
      "electricity_source_max_age_seconds": "float(15,3600)",
      "electricity_max_gap_seconds": "float(15,300)",
      "electricity_telemetry_max_age_seconds": "float(15,3600)"
    },
    "recording": {
      "max_interval_minutes": "float(0.25,60)",
      "annual_budget_gb": "float(0.01,10000)"
    },
    "replication": {
      "enabled": "bool",
      "directory": "str?",
      "ssh_host": "str?",
      "remote_directory": "str?",
      "receiver_path": "str?",
      "node_path": "str",
      "rsync_path": "str",
      "remote_rsync_path": "str",
      "interval_seconds": "int(10,86400)",
      "timeout_seconds": "int(30,86400)",
      "stale_seconds": "int(30,604800)",
      "ssh_config": "str?"
    },
    "pairing": {
      "enabled": "bool",
      "pair_id": "str?",
      "token": "password?",
      "peer_url": "str?",
      "listen_host": "str",
      "port": "int(1,65535)",
      "directory": "str?",
      "interval_seconds": "int(10,86400)",
      "timeout_seconds": "int(30,86400)",
      "vip_interface": "str?",
      "vip_address": "str?",
      "vip_prefix": "int(1,30)",
      "vip_helper": "str",
      "vip_socket": "str?"
    },
    "shelly": {
